[debug] [2026-05-17T17:28:44.828Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/neuroads-production/rulesets {"name":"projects/neuroads-production/rulesets/07c0d533-476a-429c-b4e3-85c7fa9e6542","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isWorkspaceOwner(workspaceUserId) {\n      return isSignedIn() && request.auth.uid == workspaceUserId;\n    }\n\n    match /users/{userId} {\n      allow read, write: if isSignedIn() && request.auth.uid == userId;\n    }\n\n    match /users/{userId}/{document=**} {\n      allow read, write: if isSignedIn() && request.auth.uid == userId;\n    }\n\n    match /admin_workspaces/{workspaceUserId} {\n      allow read, write: if isWorkspaceOwner(workspaceUserId);\n\n      match /{collectionId}/{docId} {\n        allow read, write: if isWorkspaceOwner(workspaceUserId);\n      }\n\n      match /{collectionId}/{docId}/{nestedCollection}/{nestedDocId} {\n        allow read, write: if isWorkspaceOwner(workspaceUserId);\n      }\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-17T17:28:46.817759Z","metadata":{"services":["cloud.firestore"]}}
