rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceOwner(workspaceUserId) {
      return isSignedIn() && request.auth.uid == workspaceUserId;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /admin_workspaces/{workspaceUserId} {
      allow read, write: if isWorkspaceOwner(workspaceUserId);

      match /{collectionId}/{docId} {
        allow read, write: if isWorkspaceOwner(workspaceUserId);
      }

      match /{collectionId}/{docId}/{nestedCollection}/{nestedDocId} {
        allow read, write: if isWorkspaceOwner(workspaceUserId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
